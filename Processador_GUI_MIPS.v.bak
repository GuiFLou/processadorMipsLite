module top_hello_rom
(
    input  wire        CLOCK_50,
    input  wire [3:0]  KEY,            // KEY0=reset , KEY1=step
    output wire [6:0]  HEX0, HEX1, HEX2, HEX3, HEX4, HEX5, HEX6
);
//------------------------------------------------------------
// 1) clock lento ~1 Hz
//------------------------------------------------------------
wire clk1Hz;
divisor_Freq #(.DIV(25_000_000)) u_div (.clk_in(CLOCK_50), .clk_out(clk1Hz));

//------------------------------------------------------------
// 2) debounce dos botões (permanece no clock rápido)
//------------------------------------------------------------
wire rst_db, step_db;
Debounce d_rst (.clk(CLOCK_50), .btn_in(~KEY[0]), .btn_out(rst_db));
Debounce d_stp (.clk(CLOCK_50), .btn_in(~KEY[1]), .btn_out(step_db));

//------------------------------------------------------------
// 3) sincroniza step_db no clock lento e gera pulso
//------------------------------------------------------------
reg st_ff1, st_ff2;
always @(posedge clk1Hz or posedge rst_db) begin
    if (rst_db) begin
        st_ff1 <= 1'b0;
        st_ff2 <= 1'b0;
    end else begin
        st_ff1 <= step_db;
        st_ff2 <= st_ff1;
    end
end
wire step_pulse =  st_ff1 & ~st_ff2;    // 1 ciclo em clk1Hz

//------------------------------------------------------------
// 4) Program Counter (incrementa só se step_pulse)
//------------------------------------------------------------
reg [7:0] PC;
always @(posedge clk1Hz or posedge rst_db) begin
    if (rst_db)
        PC <= 8'd0;
    else if (step_pulse)
        PC <= PC + 1'd1;
end

//------------------------------------------------------------
// 5) ROM  (somente para teste, não usamos o dado lido agora)
//------------------------------------------------------------
wire [31:0] instr;
single_port_rom u_rom (.clk(clk1Hz), .addr(PC), .q(instr));

//------------------------------------------------------------
// 6) Mostra o **PC** nos 7 SEG
//------------------------------------------------------------
DataOutput u_out (.clk(clk1Hz), .value({24'd0, PC}),
                  .HEX0(HEX0),.HEX1(HEX1),.HEX2(HEX2),
                  .HEX3(HEX3),.HEX4(HEX4),.HEX5(HEX5),.HEX6(HEX6));
endmodule

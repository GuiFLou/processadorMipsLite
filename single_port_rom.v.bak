module single_port_rom
#(
    parameter DATA_W   = 32,
    parameter ADDR_W   = 8,            // 256 palavras
    parameter MEM_FILE = "gcd.txt"     // binário do compilador
)
(
    input  wire                   clk,
    input  wire [ADDR_W-1:0]      addr,
    output reg  [DATA_W-1:0]      q
);
    reg [DATA_W-1:0] mem [0:(1<<ADDR_W)-1];

    initial $readmemb(MEM_FILE, mem);      // funciona na síntese Lite

    always @(posedge clk)
        q <= mem[addr];
endmodule
